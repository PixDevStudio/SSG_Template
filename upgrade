#!/usr/bin/env bash
set -euo pipefail

ok() { printf '✓ %s\n' "$1"; }
fail() { printf '✗ %s\n' "$1" >&2; exit 1; }

project_root=${SSG_UPGRADE_ROOT:-$(cd "$(dirname "$0")" && pwd)}
official_repository=${SSG_UPGRADE_REPOSITORY:-https://github.com/PixDevStudio/SSG_Template.git}
official_branch=${SSG_UPGRADE_BRANCH:-main}
official_remote='ssg-upstream'

# Run from a temporary copy so Git can safely replace upgrade itself.
if [[ -z "${SSG_UPGRADE_RUNNING:-}" ]]; then
	runtime_script=$(mktemp)
	cp "$0" "$runtime_script"
	chmod +x "$runtime_script"
	set +e
	SSG_UPGRADE_ROOT="$project_root" SSG_UPGRADE_RUNNING=1 bash "$runtime_script" "$@"
	exit_code=$?
	set -e
	rm -f "$runtime_script"
	exit "$exit_code"
fi

cd "$project_root"

check_only=false
for argument in "$@"; do
	case "$argument" in
		--check) check_only=true ;;
		--with-previews|--without-previews) ;;
		--help|-h)
			printf 'Usage : ./upgrade [--check]\n\n'
			printf 'À exécuter dans Bash ou WSL, jamais dans PowerShell.\n'
			printf 'Dépôt officiel : https://github.com/PixDevStudio/SSG_Template.git\n'
			printf '  --check             vérifie les mises à jour sans les appliquer\n'
			exit 0
			;;
		*) fail "Option inconnue : ${argument}" ;;
	esac
done

[[ -n "${BASH_VERSION:-}" ]] || fail "Cette commande nécessite Bash ou WSL, pas PowerShell."
command -v git >/dev/null 2>&1 || fail "Git n'est pas installé."
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Ce dossier ne provient pas d'un dépôt Git. Téléchargez la nouvelle version manuellement."

branch=$(git symbolic-ref --quiet --short HEAD) || fail "La copie Git est en mode detached HEAD. Placez-vous sur une branche avant l'upgrade."

if [[ -n $(git status --porcelain) ]]; then
	fail "Des modifications locales ne sont pas enregistrées. Faites un commit ou utilisez git stash, puis relancez ./upgrade."
fi

if git remote get-url "$official_remote" >/dev/null 2>&1; then
	git remote set-url "$official_remote" "$official_repository"
else
	git remote add "$official_remote" "$official_repository"
fi

upstream="${official_remote}/${official_branch}"
printf 'Recherche des mises à jour depuis %s (%s)...\n\n' "$official_repository" "$official_branch"
git fetch --prune "$official_remote" "$official_branch"
git rev-parse --verify "$upstream" >/dev/null 2>&1 || fail "La branche officielle ${official_branch} est introuvable."

read -r ahead behind < <(git rev-list --left-right --count "HEAD...${upstream}")

if (( behind == 0 )); then
	if (( ahead > 0 )); then
		ok "Version officielle déjà intégrée; ${ahead} commit(s) local(aux) sont conservés"
	else
		ok 'Le SSG est déjà à jour'
	fi
	exit 0
fi

if (( ahead > 0 )); then
	fail "La branche locale ${branch} et la version officielle ont divergé. Intégrez les changements avec Git, puis relancez ./upgrade."
fi

printf '%s mise(s) à jour disponible(s).\n' "$behind"
if [[ "$check_only" == true ]]; then
	printf 'Lancez ./upgrade pour les appliquer.\n'
	exit 0
fi

git merge --ff-only "$upstream"
ok 'Fichiers du SSG mis à jour'

[[ -x ./install ]] || chmod +x ./install
printf '\nApplication des dépendances et vérifications de la nouvelle version...\n\n'
./install

ok 'Upgrade terminé'