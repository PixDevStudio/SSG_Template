    "data": "src/data/header_centre.json"
  },
  "files": {
    "files/header-centre.html": "src/partials/header-centre.html",
    "files/header-centre.css": "src/styles/templates/header-centre.css",
    "files/header_centre.json": "src/data/header_centre.json",
    "README.md": "src/template-docs/header/header-centre/README.md"
  }
}
